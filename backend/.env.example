# ============================================================
# SKYDASH BANK — Variables d'environnement (EXEMPLE)
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS COMMITTER le fichier .env dans Git
# ============================================================

NODE_ENV=development
PORT=4000

# ---- JWT ----
# Générer avec: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_SECRET_KEY_HERE
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_64_CHARS_SECRET_KEY_HERE
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- Base de données ----
DB_TYPE=sqlite
DB_PATH=./data/skydash_bank.db
# Pour PostgreSQL en production:
# DATABASE_URL=postgresql://user:password@host:5432/skydash_bank?sslmode=require

# ---- Sécurité ----
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:3000,https://skydash-bank.com
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_64_CHARS_HERE

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ---- MFA ----
MFA_ISSUER=SkyDash Bank
MFA_REQUIRED=true

# ---- Logs ----
LOG_LEVEL=info
LOG_DIR=./logs

# ---- Email (Alertes sécurité) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@skydash-bank.com
SMTP_PASS=CHANGE_ME
SECURITY_ALERT_EMAIL=security@skydash-bank.com

# ---- Session ----
SESSION_TIMEOUT_MINUTES=15
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
